<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>Enterprise.Security</PackageId>
		<Version>1.0.0</Version>
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<Description>
			Reusable authentication and authorization components for .NET applications.
		</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Enterprise.Security.Core\Enterprise.Security.Core.csproj"
						  PrivateAssets="all" />
		<ProjectReference Include="..\..\src\Enterprise.Security.Authentication\Enterprise.Security.Authentication.csproj"
						  PrivateAssets="all" />
		<ProjectReference Include="..\..\src\Enterprise.Security.Authorization\Enterprise.Security.Authorization.csproj"
						  PrivateAssets="all" />
		<ProjectReference Include="..\..\src\Enterprise.Security.AspNetCore\Enterprise.Security.AspNetCore.csproj"
						  PrivateAssets="all" />
	</ItemGroup>


	<ItemGroup>
		<None Include="..\..\src\Enterprise.Security.Core\bin\$(Configuration)\net10.0\Enterprise.Security.Core.dll"
			  Pack="true"
			  PackagePath="lib/net10.0/" />

		<None Include="..\..\src\Enterprise.Security.Authentication\bin\$(Configuration)\net10.0\Enterprise.Security.Authentication.dll"
			  Pack="true"
			  PackagePath="lib/net10.0/" />

		<None Include="..\..\src\Enterprise.Security.Authorization\bin\$(Configuration)\net10.0\Enterprise.Security.Authorization.dll"
			  Pack="true"
			  PackagePath="lib/net10.0/" />

		<None Include="..\..\src\Enterprise.Security.AspNetCore\bin\$(Configuration)\net10.0\Enterprise.Security.AspNetCore.dll"
			  Pack="true"
			  PackagePath="lib/net10.0/" />
	</ItemGroup>

</Project>
